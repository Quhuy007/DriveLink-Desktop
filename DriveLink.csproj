<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Bản Windows 10 2004 SDK để dùng Windows Hello (Windows.Security.Credentials) bảo vệ token; vẫn chạy từ Windows 10 1809. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DriveLink</AssemblyName>
    <RootNamespace>DriveLink</RootNamespace>
    <!-- Chỉ giữ tài nguyên tiếng Việt của thư viện, bỏ các ngôn ngữ khác để gói nhỏ hơn. -->
    <SatelliteResourceLanguages>vi</SatelliteResourceLanguages>
    <Version>1.4.0</Version>
    <StartupObject>DriveLink.App</StartupObject>
    <Authors>Quang Huy</Authors>
    <Product>DriveLink — Quang Huy</Product>
    <ApplicationIcon>Assets\DriveLink.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests\**" /><Page Remove="tests\**" /></ItemGroup>
  <ItemGroup><Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/></ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="supabase\**\*" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\DriveLink.png" LogicalName="DriveLink.BrandIcon" />
    <EmbeddedResource Include="Assets\DriveLink-web.png" LogicalName="DriveLink.WebIcon" />
    <EmbeddedResource Include="Assets\DriveLink.ico" LogicalName="DriveLink.WinIcon" />
  </ItemGroup>
</Project>

