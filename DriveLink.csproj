<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DriveLink</AssemblyName>
    <RootNamespace>DriveLink</RootNamespace>
    <Version>0.8.0</Version>
    <StartupObject>DriveLink.App</StartupObject>
    <Authors>Quang Huy</Authors>
    <Product>DriveLink — Quang Huy</Product>
    <ApplicationIcon>Assets\DriveLink.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests\**" /><Page Remove="tests\**" /></ItemGroup>
  <ItemGroup><Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/></ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="supabase\**\*" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\DriveLink.png" LogicalName="DriveLink.BrandIcon" />
    <EmbeddedResource Include="Assets\DriveLink-web.png" LogicalName="DriveLink.WebIcon" />
    <EmbeddedResource Include="Assets\DriveLink.ico" LogicalName="DriveLink.WinIcon" />
  </ItemGroup>
</Project>
