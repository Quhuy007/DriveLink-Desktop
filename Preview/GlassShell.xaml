<!-- Bản dựng thử thứ hai: kính lỏng, nền tối, lưới Bento gồm các widget. Chỉ dùng dữ liệu minh họa, không đọc tài khoản và không gọi Google Drive. -->
<Window x:Class="DriveLink.Preview.GlassShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DriveLink"
        xmlns:ui="clr-namespace:DriveLink.Ui"
        Title="DriveLink — Bản dựng thử Liquid Glass" Icon="{x:Static local:AppBrand.Icon}"
        Width="1380" Height="880" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="#070A12" Foreground="#F2F5FB" FontSize="13" UseLayoutRounding="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DriveLink;component/Ui/GlassTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root" ClipToBounds="True">
    <!-- Nền cực quang trôi chậm phía sau lớp kính -->
    <Canvas IsHitTestVisible="False">
      <Ellipse Width="820" Height="820" Canvas.Left="-220" Canvas.Top="-300">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#8C3B6CFF" Offset="0"/><GradientStop Color="#003B6CFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="BlobA"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="900" Height="900" Canvas.Left="640" Canvas.Top="320">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#7A8B5CF6" Offset="0"/><GradientStop Color="#008B5CF6" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="BlobB"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="680" Height="680" Canvas.Left="980" Canvas.Top="-260">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#5C14B8A6" Offset="0"/><GradientStop Color="#0014B8A6" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="BlobC"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="620" Height="620" Canvas.Left="120" Canvas.Top="560">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#40EC4899" Offset="0"/><GradientStop Color="#00EC4899" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="BlobD"/></Ellipse.RenderTransform>
      </Ellipse>
    </Canvas>
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush RadiusX="0.75" RadiusY="0.8"><GradientStop Color="#00050810" Offset="0.5"/><GradientStop Color="#B0050810" Offset="1"/></RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Grid x:Name="Layout" Margin="16,12,16,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="64"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Thanh trên nổi dạng viên thuốc -->
      <Border Grid.ColumnSpan="2" Style="{StaticResource GlPanel}" Padding="10,0,8,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
            <Image Source="{x:Static local:AppBrand.Icon}" Width="26" Height="26"/>
            <TextBlock Text="DriveLink" FontFamily="{StaticResource GlDisplayFont}" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
            <Border Background="#10FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="18" Height="36" Padding="3">
              <Grid>
                <Border x:Name="SegmentPill" Width="104" HorizontalAlignment="Left" CornerRadius="15" Background="{StaticResource GlAccentFill}" BorderBrush="#59FFFFFF" BorderThickness="1">
                  <Border.RenderTransform><TranslateTransform x:Name="SegmentShift"/></Border.RenderTransform>
                  <Border.Effect><DropShadowEffect Color="#5B8CFF" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
                </Border>
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="SegPersonal" Style="{StaticResource GlSegment}" IsChecked="True" Checked="Account_Checked">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#9DC0FF" VerticalAlignment="Center"/><TextBlock Text="Cá nhân" Margin="7,0,0,0" FontWeight="SemiBold"/></StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="SegWork" Style="{StaticResource GlSegment}" Checked="Account_Checked">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource GlGreen}" VerticalAlignment="Center"/><TextBlock Text="Công ty" Margin="7,0,0,0" FontWeight="SemiBold"/></StackPanel>
                  </RadioButton>
                </StackPanel>
              </Grid>
            </Border>
            <Button Style="{StaticResource GlRound}" Margin="6,0,0,0" Click="Placeholder_Click" Tag="Thêm tài khoản Google" ToolTip="Thêm tài khoản Google">
              <TextBlock Style="{StaticResource GlIcon}" Text="&#xE710;" FontSize="12"/>
            </Button>
          </StackPanel>
          <Border Grid.Column="3" Width="300" Height="36" Background="#10FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="18" Margin="0,0,10,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource GlIcon}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource GlMuted}" Margin="14,0,10,0"/>
              <TextBlock Grid.Column="1" Text="Tìm tệp, không gian, email…" Foreground="{StaticResource GlFaint}" VerticalAlignment="Center"/>
              <Border Grid.Column="2" Background="#14FFFFFF" CornerRadius="7" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="Ctrl K" FontSize="11" FontFamily="{StaticResource GlMonoFont}" Foreground="{StaticResource GlMuted}"/>
              </Border>
            </Grid>
          </Border>
          <Border Grid.Column="4" Background="#262E2412" BorderBrush="#55FBBF24" BorderThickness="1" CornerRadius="13" Padding="10,3" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Không có tệp nào được gửi hay tải thật">
            <TextBlock Text="Bản thử · dữ liệu minh họa" FontSize="11.5" Foreground="{StaticResource GlAmber}"/>
          </Border>
          <Button Grid.Column="5" Style="{StaticResource GlRound}" Click="Placeholder_Click" Tag="Chưa có thông báo mới" ToolTip="Thông báo">
            <Grid>
              <TextBlock Style="{StaticResource GlIcon}" Text="&#xEA8F;" FontSize="14"/>
              <Ellipse Width="7" Height="7" Fill="{StaticResource GlRose}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"/>
            </Grid>
          </Button>
          <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="10,0,0,0">
            <Button Style="{StaticResource GlRound}" Click="Minimize_Click" ToolTip="Thu nhỏ"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE921;" FontSize="10"/></Button>
            <Button Style="{StaticResource GlRound}" Click="Maximize_Click" ToolTip="Phóng to"><TextBlock x:Name="MaxGlyph" Style="{StaticResource GlIcon}" Text="&#xE922;" FontSize="10"/></Button>
            <Button Style="{StaticResource GlRoundClose}" Click="Close_Click" ToolTip="Đóng"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE8BB;" FontSize="10"/></Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Dock điều hướng dọc -->
      <Border Grid.Row="1" Style="{StaticResource GlPanel}" CornerRadius="32" Margin="0,16,0,0" Padding="0,8" VerticalAlignment="Top">
        <StackPanel HorizontalAlignment="Center">
          <Grid>
            <Border x:Name="DockPill" Width="44" Height="44" Margin="0,4,0,0" VerticalAlignment="Top" CornerRadius="14" Background="#335B8CFF" BorderBrush="#665B8CFF" BorderThickness="1">
              <Border.RenderTransform><TranslateTransform x:Name="DockShift"/></Border.RenderTransform>
            </Border>
            <StackPanel>
              <RadioButton Style="{StaticResource GlDock}" IsChecked="True" Tag="0" Checked="Dock_Checked" ToolTip="Tổng quan"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE80F;" FontSize="17"/></RadioButton>
              <RadioButton Style="{StaticResource GlDock}" Tag="1" Checked="Dock_Checked" ToolTip="Tệp"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE8B7;" FontSize="17"/></RadioButton>
              <RadioButton Style="{StaticResource GlDock}" Tag="2" Checked="Dock_Checked" ToolTip="Không gian chung"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE716;" FontSize="17"/></RadioButton>
              <RadioButton Style="{StaticResource GlDock}" Tag="3" Checked="Dock_Checked" ToolTip="Truyền tải"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE8AB;" FontSize="17"/></RadioButton>
              <RadioButton Style="{StaticResource GlDock}" Tag="4" Checked="Dock_Checked" ToolTip="Hoạt động"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE81C;" FontSize="17"/></RadioButton>
            </StackPanel>
          </Grid>
          <Rectangle Height="1" Width="28" Fill="{StaticResource GlLine}" Margin="0,8"/>
          <Button Style="{StaticResource GlRound}" Width="44" Height="44" Click="Placeholder_Click" Tag="Bản thử: chưa có màn Cài đặt" ToolTip="Cài đặt"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE713;" FontSize="17"/></Button>
        </StackPanel>
      </Border>

      <!-- Nội dung chính -->
      <Grid Grid.Row="1" Grid.Column="1" Margin="16,16,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="4,0,4,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="Greeting" FontFamily="{StaticResource GlDisplayFont}" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="GreetingSub" Foreground="{StaticResource GlMuted}" FontSize="13.5" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Border Style="{StaticResource GlChip}">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE898;" FontSize="11" Foreground="{StaticResource GlAccent}"/><TextBlock x:Name="SentToday" Margin="7,0,0,0" FontSize="12"/></StackPanel>
            </Border>
            <Border Style="{StaticResource GlChip}" Margin="8,0,0,0">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE896;" FontSize="11" Foreground="{StaticResource GlGreen}"/><TextBlock x:Name="ReceivedToday" Margin="7,0,0,0" FontSize="12"/></StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Lưới Bento 4 cột × 3 hàng -->
        <Grid x:Name="Bento" Grid.Row="1" Margin="-4,0,-4,-8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Widget: vùng thả tệp -->
          <ui:GlassCard x:Name="HeroCard" Grid.ColumnSpan="2" Grid.RowSpan="2" Padding="26,22">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="KHÔNG GIAN ĐANG CHỌN" Style="{StaticResource GlLabel}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Ellipse x:Name="HeroDot" Width="10" Height="10" Fill="{StaticResource GlAccent}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeroSpace" FontFamily="{StaticResource GlDisplayFont}" FontSize="22" FontWeight="SemiBold" Margin="10,0,0,0"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Grid>
                    <Border Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Left" Background="{StaticResource GlAccent}" BorderBrush="#0B1020" BorderThickness="2"><TextBlock Text="MA" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource GlTeal}" BorderBrush="#0B1020" BorderThickness="2" Margin="22,0,0,0" HorizontalAlignment="Left"><TextBlock Text="MB" FontSize="10.5" FontWeight="Bold" Foreground="#06231F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  </Grid>
                  <TextBlock x:Name="HeroMembers" Foreground="{StaticResource GlMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Grid Width="230" Height="190" HorizontalAlignment="Center">
                  <Ellipse x:Name="Pulse1" Width="132" Height="132" Stroke="#995B8CFF" StrokeThickness="2" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform x:Name="Pulse1Scale"/></Ellipse.RenderTransform></Ellipse>
                  <Ellipse x:Name="Pulse2" Width="132" Height="132" Stroke="#99A78BFA" StrokeThickness="2" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform x:Name="Pulse2Scale"/></Ellipse.RenderTransform></Ellipse>
                  <Ellipse Width="200" Height="200">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#555B8CFF" Offset="0"/><GradientStop Color="#005B8CFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                  </Ellipse>
                  <Border x:Name="Orb" Width="124" Height="124" CornerRadius="62" Background="{StaticResource GlAccentFill}" BorderBrush="#8CFFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="OrbScale"/></Border.RenderTransform>
                    <Border.Effect><DropShadowEffect Color="#5B8CFF" BlurRadius="44" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
                    <Grid>
                      <Border CornerRadius="62">
                        <Border.Background><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#59FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.55"/></LinearGradientBrush></Border.Background>
                      </Border>
                      <TextBlock x:Name="OrbIcon" Style="{StaticResource GlIcon}" Text="&#xE898;" FontSize="38" Foreground="White" HorizontalAlignment="Center"/>
                    </Grid>
                  </Border>
                </Grid>
                <TextBlock x:Name="DropTitle" Text="Thả tệp hoặc thư mục vào đây" FontFamily="{StaticResource GlDisplayFont}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock x:Name="DropHint" Text="DriveLink gửi lên Google Drive, máy kia nhận trong vài giây" Foreground="{StaticResource GlMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource GlPrimaryButton}" Click="Placeholder_Click" Tag="Bản thử: chưa nối hộp chọn tệp">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE8E5;" FontSize="13"/><TextBlock Text="Chọn tệp" Margin="8,0,0,0" FontWeight="SemiBold"/></StackPanel>
                </Button>
                <Button Style="{StaticResource GlButton}" Margin="10,0,0,0" Click="Placeholder_Click" Tag="Bản thử: chưa nối hộp chọn thư mục">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE838;" FontSize="13"/><TextBlock Text="Chọn thư mục" Margin="8,0,0,0"/></StackPanel>
                </Button>
                <Button Style="{StaticResource GlButton}" Margin="10,0,0,0" Click="Placeholder_Click" Tag="Bản thử: chưa nối lưu từ liên kết">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE71B;" FontSize="13"/><TextBlock Text="Từ liên kết" Margin="8,0,0,0"/></StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </ui:GlassCard>

          <!-- Widget: dung lượng -->
          <ui:GlassCard Grid.Column="2">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid>
                <TextBlock Text="Dung lượng" Style="{StaticResource GlTitle}"/>
                <TextBlock Text="Google Drive" Foreground="{StaticResource GlFaint}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <UniformGrid Grid.Row="1" Columns="2" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="84" Height="84">
                    <Ellipse Stroke="#1FFFFFFF" StrokeThickness="8"/>
                    <Ellipse x:Name="RingPersonal" Stroke="{StaticResource GlAccent}" StrokeThickness="8" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse>
                    <TextBlock x:Name="RingPersonalText" FontFamily="{StaticResource GlDisplayFont}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock Text="Cá nhân" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                  <TextBlock Text="778 GB / 2 TB" Foreground="{StaticResource GlMuted}" FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="84" Height="84">
                    <Ellipse Stroke="#1FFFFFFF" StrokeThickness="8"/>
                    <Ellipse x:Name="RingWork" Stroke="{StaticResource GlGreen}" StrokeThickness="8" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse>
                    <TextBlock x:Name="RingWorkText" FontFamily="{StaticResource GlDisplayFont}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock Text="Công ty" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                  <TextBlock Text="1,6 TB / 5 TB" Foreground="{StaticResource GlMuted}" FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>
              </UniformGrid>
            </Grid>
          </ui:GlassCard>

          <!-- Widget: truyền tải trực tiếp -->
          <ui:GlassCard Grid.Column="3" Grid.RowSpan="2">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <TextBlock Text="Truyền tải" Style="{StaticResource GlTitle}"/>
                <Border HorizontalAlignment="Right" Background="#1A4ADE80" CornerRadius="10" Padding="8,2">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{StaticResource GlGreen}" VerticalAlignment="Center"/>
                    <TextBlock Text="Trực tiếp" FontSize="11.5" Foreground="{StaticResource GlGreen}" Margin="6,0,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
              <UniformGrid Grid.Row="1" Columns="2" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="TẢI LÊN" Style="{StaticResource GlLabel}"/>
                  <TextBlock x:Name="UpSpeed" FontFamily="{StaticResource GlMonoFont}" FontSize="19" Foreground="#8FB0FF" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="TẢI VỀ" Style="{StaticResource GlLabel}"/>
                  <TextBlock x:Name="DownSpeed" FontFamily="{StaticResource GlMonoFont}" FontSize="19" Foreground="{StaticResource GlGreen}" Margin="0,4,0,0"/>
                </StackPanel>
              </UniformGrid>
              <Canvas x:Name="Spark" Grid.Row="2" Height="84" Margin="0,12,0,4" ClipToBounds="True" SizeChanged="Spark_SizeChanged">
                <Polygon x:Name="SparkFill">
                  <Polygon.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#665B8CFF" Offset="0"/><GradientStop Color="#005B8CFF" Offset="1"/></LinearGradientBrush></Polygon.Fill>
                </Polygon>
                <Polyline x:Name="SparkDown" Stroke="{StaticResource GlGreen}" StrokeThickness="1.5" Opacity="0.75" StrokeLineJoin="Round"/>
                <Polyline x:Name="SparkUp" Stroke="#8FB0FF" StrokeThickness="2" StrokeLineJoin="Round"/>
              </Canvas>
              <Grid Grid.Row="3" Margin="0,8,0,2">
                <TextBlock Text="ĐANG CHẠY" Style="{StaticResource GlLabel}"/>
                <TextBlock x:Name="TaskCount" Style="{StaticResource GlLabel}" HorizontalAlignment="Right"/>
              </Grid>
              <ItemsControl x:Name="TaskList" Grid.Row="4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,8,0,2">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource GlIcon}" Text="{Binding Direction}" Foreground="{Binding Brush}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Percent}" FontFamily="{StaticResource GlMonoFont}" FontSize="11.5" Foreground="{StaticResource GlMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                      </Grid>
                      <ProgressBar Style="{StaticResource GlProgress}" Value="{Binding Progress, Mode=OneWay}" Foreground="{Binding Brush}" Margin="22,6,0,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Grid.Row="5" Style="{StaticResource GlButton}" HorizontalAlignment="Stretch" Click="Placeholder_Click" Tag="Bản thử: chưa có màn hàng đợi">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE8FD;" FontSize="12"/><TextBlock Text="Mở hàng đợi" Margin="8,0,0,0"/></StackPanel>
              </Button>
            </Grid>
          </ui:GlassCard>

          <!-- Widget: không gian chung -->
          <ui:GlassCard Grid.Column="2" Grid.Row="1" Padding="16,16">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="4,0,0,4">
                <TextBlock Text="Không gian" Style="{StaticResource GlTitle}"/>
                <Button Style="{StaticResource GlRound}" Width="28" Height="28" HorizontalAlignment="Right" Click="Placeholder_Click" Tag="Bản thử: chưa nối tạo không gian" ToolTip="Tạo không gian"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE710;" FontSize="11"/></Button>
              </Grid>
              <ItemsControl x:Name="SpaceList" Grid.Row="1" VerticalAlignment="Center">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource GlRow}" Padding="8,6">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Ellipse Width="9" Height="9" Fill="{Binding Dot}" HorizontalAlignment="Left"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Members}" FontSize="11" Foreground="{StaticResource GlMuted}"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="#2A5B8CFF" CornerRadius="9" Padding="7,1" VerticalAlignment="Center" Visibility="{Binding HasBadge, Converter={StaticResource GlBoolToVis}}">
                          <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold" Foreground="#A9C2FF"/>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </ui:GlassCard>

          <!-- Widget: gửi chéo tài khoản -->
          <ui:GlassCard x:Name="CrossCard" Grid.Row="2" Grid.ColumnSpan="2">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Gửi chéo tài khoản" Style="{StaticResource GlTitle}" HorizontalAlignment="Left"/>
                  <TextBlock Text="Google sao chép trên máy chủ, không tốn băng thông máy này" Foreground="{StaticResource GlMuted}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1A4ADE80" BorderBrush="#664ADE80" BorderThickness="1" CornerRadius="13" Padding="10,3" VerticalAlignment="Center" Margin="10,0">
                  <TextBlock Text="0 MB qua máy này" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource GlGreen}"/>
                </Border>
                <Button x:Name="CrossButton" Grid.Column="2" Style="{StaticResource GlPrimaryButton}" Height="34" Padding="14,0" Click="Cross_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock x:Name="CrossButtonIcon" Style="{StaticResource GlIcon}" Text="&#xE8AB;" FontSize="12"/><TextBlock x:Name="CrossButtonText" Text="Gửi chéo" Margin="8,0,0,0" FontWeight="SemiBold"/></StackPanel>
                </Button>
              </Grid>
              <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                <Border Background="#1F5B8CFF" BorderBrush="#4D5B8CFF" BorderThickness="1" CornerRadius="16" Padding="14,9">
                  <StackPanel>
                    <TextBlock x:Name="CrossSourceLabel" FontSize="10.5" FontWeight="Bold" Foreground="#9DB8FF"/>
                    <TextBlock Text="Video quay dựng 2026" FontSize="13.5" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="24 tệp · 153,7 GB" FontSize="11.5" Foreground="{StaticResource GlMuted}"/>
                  </StackPanel>
                </Border>
                <Grid Grid.Column="1" Margin="14,0">
                  <Rectangle Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Center" Opacity="0.45">
                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#5B8CFF" Offset="0"/><GradientStop Color="#A78BFA" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                  </Rectangle>
                  <Canvas x:Name="FlowCanvas" Height="16" VerticalAlignment="Center" ClipToBounds="True" SizeChanged="Flow_SizeChanged"/>
                  <TextBlock x:Name="CrossStatus" FontFamily="{StaticResource GlMonoFont}" FontSize="11.5" Foreground="{StaticResource GlMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,34,0,0"/>
                </Grid>
                <Border Grid.Column="2" Background="#24A78BFA" BorderBrush="#55A78BFA" BorderThickness="1" CornerRadius="16" Padding="14,9">
                  <StackPanel>
                    <TextBlock x:Name="CrossTargetLabel" FontSize="10.5" FontWeight="Bold" Foreground="#C4B5FD"/>
                    <TextBlock Text="Thư mục gốc" FontSize="13.5" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    <TextBlock x:Name="CrossTargetInfo" FontSize="11.5" Foreground="{StaticResource GlMuted}"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </ui:GlassCard>

          <!-- Widget: gần đây -->
          <ui:GlassCard Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Padding="18,16">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="2,0,0,0">
                <TextBlock Text="Gần đây" Style="{StaticResource GlTitle}"/>
                <Button Style="{StaticResource GlButton}" Height="28" Padding="12,0" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" Click="Placeholder_Click" Tag="Bản thử: chưa có màn tệp">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Xem tất cả" FontSize="12" Foreground="{StaticResource GlMuted}"/><TextBlock Style="{StaticResource GlIcon}" Text="&#xE76C;" FontSize="9" Foreground="{StaticResource GlMuted}" Margin="6,1,0,0"/></StackPanel>
                </Button>
              </Grid>
              <ItemsControl x:Name="RecentList" Grid.Row="1" VerticalAlignment="Center" Margin="-4,10,-4,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource GlTile}" Margin="4" Padding="12,12" ToolTip="{Binding Name}">
                      <StackPanel>
                        <Border Width="38" Height="38" CornerRadius="12" Background="{Binding Soft}" HorizontalAlignment="Left">
                          <TextBlock Style="{StaticResource GlIcon}" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="17" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource GlMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </ui:GlassCard>
        </Grid>
      </Grid>
    </Grid>

    <!-- "Đảo" thông báo: viên thuốc nổi ở giữa phía trên, co giãn theo trạng thái -->
    <Border x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,74,0,0" Width="160" Height="44" Opacity="0" Visibility="Collapsed"
            CornerRadius="24" Background="#EB0C111D" BorderBrush="{StaticResource GlRim}" BorderThickness="1" ClipToBounds="True" IsHitTestVisible="False">
      <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.6" Color="Black"/></Border.Effect>
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Width="22" Height="22" VerticalAlignment="Center">
          <TextBlock x:Name="IslandSpinner" Style="{StaticResource GlIcon}" Text="&#xE895;" FontSize="14" Foreground="{StaticResource GlAccent}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform><RotateTransform x:Name="IslandSpin"/></TextBlock.RenderTransform>
          </TextBlock>
          <TextBlock x:Name="IslandCheck" Style="{StaticResource GlIcon}" Text="&#xE930;" FontSize="18" Foreground="{StaticResource GlGreen}" HorizontalAlignment="Center" Visibility="Collapsed"/>
          <TextBlock x:Name="IslandInfo" Style="{StaticResource GlIcon}" Text="&#xE946;" FontSize="16" Foreground="{StaticResource GlAmber}" HorizontalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="IslandText" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="IslandSub" FontSize="11.5" Foreground="{StaticResource GlMuted}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
