<!-- Bộ màu tối dùng cho bản dựng thử giao diện. Mọi màu nằm ở đây để sau này thêm bản sáng chỉ cần một bộ khác cùng khóa. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="PvIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="PvMonoFont">Cascadia Mono, Consolas</FontFamily>

  <SolidColorBrush x:Key="PvChromeBg" Color="#0A0E16"/>
  <SolidColorBrush x:Key="PvWindowBg" Color="#0F141F"/>
  <SolidColorBrush x:Key="PvSidebarBg" Color="#121826"/>
  <SolidColorBrush x:Key="PvRaisedBg" Color="#1A2232"/>
  <SolidColorBrush x:Key="PvHoverBg" Color="#1E2839"/>
  <SolidColorBrush x:Key="PvSelectedBg" Color="#1D2D52"/>
  <SolidColorBrush x:Key="PvLine" Color="#222C3F"/>
  <SolidColorBrush x:Key="PvInk" Color="#E8EDF6"/>
  <SolidColorBrush x:Key="PvMuted" Color="#8D99AF"/>
  <SolidColorBrush x:Key="PvFaint" Color="#5E6A82"/>
  <SolidColorBrush x:Key="PvAccent" Color="#4C7DFF"/>
  <SolidColorBrush x:Key="PvAccentSoft" Color="#16264A"/>
  <SolidColorBrush x:Key="PvSuccess" Color="#34C77B"/>
  <SolidColorBrush x:Key="PvSuccessSoft" Color="#0F2A1D"/>
  <SolidColorBrush x:Key="PvWarning" Color="#F2B544"/>
  <SolidColorBrush x:Key="PvWarningSoft" Color="#2E2412"/>
  <SolidColorBrush x:Key="PvPurple" Color="#A396FF"/>
  <SolidColorBrush x:Key="PvPurpleSoft" Color="#211D40"/>
  <BooleanToVisibilityConverter x:Key="PvBoolToVis"/>

  <Style x:Key="PvIcon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource PvIconFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="PvSection" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource PvFaint}"/>
    <Setter Property="Margin" Value="10,16,0,6"/>
  </Style>

  <!-- Nút: lớp phủ trắng mờ khi rê chuột để mọi biến thể màu nền đều có phản hồi. -->
  <Style x:Key="PvGhost" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource PvInk}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"/>
            <Border x:Name="Hover" Background="White" CornerRadius="9" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.07"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.13"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PvTool" TargetType="Button" BasedOn="{StaticResource PvGhost}">
    <Setter Property="Background" Value="{StaticResource PvRaisedBg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PvLine}"/>
    <Setter Property="Padding" Value="13,8"/>
  </Style>
  <Style x:Key="PvPrimary" TargetType="Button" BasedOn="{StaticResource PvGhost}">
    <Setter Property="Background" Value="{StaticResource PvAccent}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PvAccent}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="14,8"/>
  </Style>

  <!-- Nút thu nhỏ / phóng to / đóng trên thanh tiêu đề tự vẽ. -->
  <Style x:Key="PvChromeButton" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Foreground" Value="{StaticResource PvMuted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource PvHoverBg}"/><Setter Property="Foreground" Value="{StaticResource PvInk}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PvCloseButton" TargetType="Button" BasedOn="{StaticResource PvChromeButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tab tài khoản trên thanh tiêu đề. -->
  <Style x:Key="PvTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource PvMuted}"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="GroupName" Value="PvTabs"/>
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Border x:Name="Bg" Margin="2,6" CornerRadius="8" Background="Transparent"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom" Margin="14,0" CornerRadius="1" Background="{StaticResource PvAccent}" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{StaticResource PvHoverBg}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource PvInk}"/>
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource PvRaisedBg}"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Mục điều hướng ở thanh bên. -->
  <Style x:Key="PvNav" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource PvMuted}"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="GroupName" Value="PvNav"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource PvHoverBg}"/><Setter Property="Foreground" Value="{StaticResource PvInk}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource PvSelectedBg}"/><Setter Property="Foreground" Value="White"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PvSearch" TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource PvInk}"/>
    <Setter Property="CaretBrush" Value="{StaticResource PvInk}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource PvAccent}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Background="Transparent" Focusable="False"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PvRow" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource PvInk}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="8" Margin="8,1" Height="46">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource PvHoverBg}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource PvSelectedBg}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PvProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="8"/>
    <Setter Property="Foreground" Value="{StaticResource PvSuccess}"/>
    <Setter Property="Background" Value="#1F2A3D"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" CornerRadius="4" Background="{TemplateBinding Background}"/>
            <Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thanh cuộn mảnh, áp dụng cho mọi danh sách trong cửa sổ. -->
  <Style x:Key="PvThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb"><Border Background="#2E3A52" CornerRadius="3"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb Style="{StaticResource PvThumb}" Margin="2,2"/></Track.Thumb></Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False"><Track.Thumb><Thumb Style="{StaticResource PvThumb}" Margin="2,2"/></Track.Thumb></Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
