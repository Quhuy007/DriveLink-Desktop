<!-- Bản dựng thử giao diện tối. Chỉ dùng dữ liệu minh họa: không đọc tài khoản đã lưu, không gọi Google Drive. Mở bằng tham số dòng lệnh ui-preview (xem App.xaml.cs). -->
<Window x:Class="DriveLink.Preview.PreviewShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DriveLink"
        Title="DriveLink — Bản dựng thử giao diện" Icon="{x:Static local:AppBrand.Icon}"
        Width="1320" Height="820" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PvChromeBg}" Foreground="{DynamicResource PvInk}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DriveLink;component/Preview/PreviewTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="36"/>
    </Grid.RowDefinitions>

    <!-- Thanh tiêu đề: mỗi tài khoản Google là một tab -->
    <Grid Background="{StaticResource PvChromeBg}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Image Source="{x:Static local:AppBrand.Icon}" Width="18" Height="18" Margin="16,0,8,0" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <RadioButton x:Name="TabPersonal" Style="{StaticResource PvTab}" IsChecked="True" Checked="AccountTab_Checked" Tag="personal" ToolTip="Tài khoản cá nhân">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource PvAccent}" VerticalAlignment="Center"/>
            <TextBlock Text="Cá nhân" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="PersonalActivity" Style="{StaticResource PvIcon}" Text="&#xE898;" FontSize="11" Foreground="{StaticResource PvAccent}" Margin="8,0,0,0" ToolTip="Đang gửi 3 tệp"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="TabWork" Style="{StaticResource PvTab}" Checked="AccountTab_Checked" Tag="work" ToolTip="Tài khoản công ty">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource PvSuccess}" VerticalAlignment="Center"/>
            <TextBlock Text="Công ty" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <Border x:Name="WorkBadge" Background="{StaticResource PvAccent}" CornerRadius="8" MinWidth="16" Height="16" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Có mục mới được gửi tới">
              <TextBlock Text="1" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
        </RadioButton>
        <Button Style="{StaticResource PvGhost}" WindowChrome.IsHitTestVisibleInChrome="True" Margin="4,0,0,0" Padding="10,7" ToolTip="Thêm tài khoản Google">
          <TextBlock Style="{StaticResource PvIcon}" Text="&#xE710;" FontSize="12" Foreground="{StaticResource PvMuted}"/>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Style="{StaticResource PvChromeButton}" Click="Minimize_Click" ToolTip="Thu nhỏ"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE921;" FontSize="10"/></Button>
        <Button Style="{StaticResource PvChromeButton}" Click="Maximize_Click" ToolTip="Phóng to"><TextBlock x:Name="MaxGlyph" Style="{StaticResource PvIcon}" Text="&#xE922;" FontSize="10"/></Button>
        <Button Style="{StaticResource PvCloseButton}" Click="Close_Click" ToolTip="Đóng"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE8BB;" FontSize="10"/></Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Thanh bên -->
      <Border Background="{StaticResource PvSidebarBg}" BorderBrush="{StaticResource PvLine}" BorderThickness="0,1,1,0">
        <DockPanel Margin="12,14,12,12">
          <Grid DockPanel.Dock="Top" Margin="6,0,2,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="{x:Static local:AppBrand.Icon}" Width="28" Height="28"/>
            <TextBlock Grid.Column="1" Text="DriveLink" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <Border Grid.Column="2" Background="{StaticResource PvRaisedBg}" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
              <TextBlock x:Name="VersionChip" FontSize="11" Foreground="{StaticResource PvMuted}"/>
            </Border>
          </Grid>

          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Border Background="{StaticResource PvRaisedBg}" BorderBrush="{StaticResource PvLine}" BorderThickness="1" CornerRadius="12" Padding="12">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="AvatarBg" Width="34" Height="34" CornerRadius="17" Background="{StaticResource PvAccent}">
                    <TextBlock x:Name="AvatarText" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AccountName" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AccountEmail" FontSize="11.5" Foreground="{StaticResource PvMuted}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
                <ProgressBar x:Name="QuotaBar" Style="{StaticResource PvProgress}" Height="6" Foreground="{StaticResource PvAccent}" Margin="0,12,0,6"/>
                <Grid>
                  <TextBlock x:Name="QuotaText" FontSize="11.5" Foreground="{StaticResource PvMuted}"/>
                  <TextBlock x:Name="QuotaPercent" FontSize="11.5" Foreground="{StaticResource PvMuted}" HorizontalAlignment="Right"/>
                </Grid>
              </StackPanel>
            </Border>
            <Grid Margin="0,8,0,0">
              <Button Style="{StaticResource PvGhost}" HorizontalAlignment="Left" ToolTip="Bản dựng thử: chưa nối chức năng">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource PvIcon}" Text="&#xE713;" Foreground="{StaticResource PvMuted}"/>
                  <TextBlock Text="Cài đặt" Margin="8,0,0,0" Foreground="{StaticResource PvMuted}"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource PvGhost}" HorizontalAlignment="Right" ToolTip="Kiểm tra cập nhật">
                <TextBlock Style="{StaticResource PvIcon}" Text="&#xE896;" Foreground="{StaticResource PvMuted}"/>
              </Button>
            </Grid>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Grid>
                <TextBlock Text="KHÔNG GIAN CHUNG" Style="{StaticResource PvSection}"/>
                <Button Style="{StaticResource PvGhost}" Padding="6,4" Margin="0,10,0,0" HorizontalAlignment="Right" ToolTip="Tạo không gian">
                  <TextBlock Style="{StaticResource PvIcon}" Text="&#xE710;" FontSize="10" Foreground="{StaticResource PvMuted}"/>
                </Button>
              </Grid>
              <RadioButton Style="{StaticResource PvNav}" Tag="space-machines" Checked="Nav_Checked">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Ellipse Width="8" Height="8" Fill="{StaticResource PvAccent}" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Column="1" Text="File giữa hai máy" TextTrimming="CharacterEllipsis"/>
                  <Border Grid.Column="2" Background="{StaticResource PvAccentSoft}" CornerRadius="8" Padding="6,0"><TextBlock Text="3 mới" FontSize="10.5" Foreground="#86A8FF"/></Border>
                </Grid>
              </RadioButton>
              <RadioButton Style="{StaticResource PvNav}" Tag="space-studio" Checked="Nav_Checked">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Ellipse Width="8" Height="8" Fill="{StaticResource PvPurple}" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Column="1" Text="Dự án studio" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </RadioButton>
              <RadioButton Style="{StaticResource PvNav}" Tag="space-family" Checked="Nav_Checked">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Ellipse Width="8" Height="8" Fill="{StaticResource PvWarning}" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Column="1" Text="Gia đình" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Style="{StaticResource PvIcon}" Text="&#xE735;" FontSize="10" Foreground="{StaticResource PvWarning}" ToolTip="Đã ghim"/>
                </Grid>
              </RadioButton>

              <TextBlock Text="LƯU TRỮ" Style="{StaticResource PvSection}"/>
              <RadioButton x:Name="NavDrive" Style="{StaticResource PvNav}" Tag="drive" IsChecked="True" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE8B7;" Width="24"/><TextBlock Text="Drive của tôi"/></StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource PvNav}" Tag="shared-drives" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE8F1;" Width="24"/><TextBlock Text="Drive dùng chung"/></StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource PvNav}" Tag="recent" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE81C;" Width="24"/><TextBlock Text="Gần đây"/></StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource PvNav}" Tag="starred" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE734;" Width="24"/><TextBlock Text="Có gắn dấu sao"/></StackPanel>
              </RadioButton>

              <TextBlock Text="CHIA SẺ" Style="{StaticResource PvSection}"/>
              <RadioButton Style="{StaticResource PvNav}" Tag="shared-with-me" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE716;" Width="24"/><TextBlock Text="Được chia sẻ với tôi"/></StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource PvNav}" Tag="links" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE71B;" Width="24"/><TextBlock Text="Liên kết công khai"/></StackPanel>
              </RadioButton>

              <TextBlock Text="KHÁC" Style="{StaticResource PvSection}"/>
              <RadioButton Style="{StaticResource PvNav}" Tag="trash" Checked="Nav_Checked">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE74D;" Width="24"/><TextBlock Text="Thùng rác"/></StackPanel>
              </RadioButton>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Nội dung chính -->
      <Grid Grid.Column="1" Background="{StaticResource PvWindowBg}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="20,14,20,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource PvGhost}" Padding="8,7" ToolTip="Quay lại"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE72B;" FontSize="12" Foreground="{StaticResource PvMuted}"/></Button>
            <Border Background="{StaticResource PvRaisedBg}" CornerRadius="14" Padding="10,4" Margin="8,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="CrumbDot" Width="7" Height="7" Fill="{StaticResource PvAccent}" VerticalAlignment="Center"/>
                <TextBlock x:Name="CrumbAccount" Margin="7,0,0,0" FontSize="12.5" Foreground="{StaticResource PvMuted}"/>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource PvIcon}" Text="&#xE76C;" FontSize="10" Foreground="{StaticResource PvFaint}" Margin="2,0,10,0"/>
            <TextBlock x:Name="CrumbIcon" Style="{StaticResource PvIcon}" Text="&#xE8B7;" FontSize="16" Foreground="{StaticResource PvAccent}"/>
            <TextBlock x:Name="CrumbTitle" FontSize="17" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Border Grid.Column="1" Width="340" Height="36" Background="{StaticResource PvRaisedBg}" BorderBrush="{StaticResource PvLine}" BorderThickness="1" CornerRadius="10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource PvIcon}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource PvMuted}" Margin="12,0,8,0"/>
              <Grid Grid.Column="1">
                <TextBox x:Name="SearchBox" Style="{StaticResource PvSearch}" TextChanged="Search_Changed"/>
                <TextBlock x:Name="SearchHint" Text="Tìm tệp, thư mục hoặc email…" Foreground="{StaticResource PvFaint}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"/>
              </Grid>
              <Border Grid.Column="2" Background="{StaticResource PvHoverBg}" CornerRadius="6" Padding="8,3" Margin="6">
                <TextBlock Text="Mục này" FontSize="11.5" Foreground="{StaticResource PvMuted}"/>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="20,0,20,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource PvPrimary}" ToolTip="Bản dựng thử: chưa nối chức năng">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource PvIcon}" Text="&#xE898;" FontSize="13"/>
                <TextBlock Text="Tải lên" Margin="8,0,0,0" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource PvIcon}" Text="&#xE70D;" FontSize="9" Margin="10,1,0,0"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource PvTool}" Margin="8,0,0,0" ToolTip="Bản dựng thử: chưa nối chức năng">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE8F4;" FontSize="13" Foreground="{StaticResource PvMuted}"/><TextBlock Text="Thư mục mới" Margin="8,0,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource PvTool}" Margin="8,0,0,0" ToolTip="Dán liên kết Google Drive để lưu vào tài khoản này">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE71B;" FontSize="13" Foreground="{StaticResource PvMuted}"/><TextBlock Text="Từ liên kết" Margin="8,0,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource PvTool}" Margin="8,0,0,0" Click="Cross_Click" ToolTip="Xem lại hiệu ứng thông báo gửi chéo">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE8AB;" FontSize="13" Foreground="{StaticResource PvPurple}"/><TextBlock Text="Gửi sang tài khoản khác" Margin="8,0,0,0"/></StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBlock x:Name="CountText" Foreground="{StaticResource PvMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PvGhost}" Padding="8,7" ToolTip="Làm mới"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE72C;" FontSize="13" Foreground="{StaticResource PvMuted}"/></Button>
          </StackPanel>
        </Grid>

        <!-- Tiêu đề cột: cùng độ rộng với mẫu dòng bên dưới -->
        <Border Grid.Row="2" Margin="20,0,20,0" Padding="8,0,8,8" BorderBrush="{StaticResource PvLine}" BorderThickness="0,0,0,1">
          <Grid TextElement.Foreground="{StaticResource PvFaint}" TextElement.FontSize="11.5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="190"/>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBlock Text="Tên" FontWeight="SemiBold" Foreground="{StaticResource PvMuted}"/>
              <TextBlock Style="{StaticResource PvIcon}" Text="&#xE74A;" FontSize="9" Margin="6,1,0,0" Foreground="{StaticResource PvMuted}"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="Chủ sở hữu"/>
            <TextBlock Grid.Column="3" Text="Ngày sửa"/>
            <TextBlock Grid.Column="4" Text="Kích thước" HorizontalAlignment="Right" Margin="0,0,14,0"/>
          </Grid>
        </Border>

        <Grid Grid.Row="3">
          <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Margin="12,6,12,0" ItemContainerStyle="{StaticResource PvRow}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="160"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource PvIcon}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontSize="18" HorizontalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource PvIcon}" Text="&#xE735;" FontSize="10" Foreground="{StaticResource PvWarning}" Margin="8,0,0,0" Visibility="{Binding Starred, Converter={StaticResource PvBoolToVis}}" ToolTip="Có gắn dấu sao"/>
                    <TextBlock Style="{StaticResource PvIcon}" Text="&#xE716;" FontSize="11" Foreground="{StaticResource PvMuted}" Margin="8,0,0,0" Visibility="{Binding Shared, Converter={StaticResource PvBoolToVis}}" ToolTip="Đã chia sẻ"/>
                    <Border Background="{StaticResource PvAccentSoft}" CornerRadius="6" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsNew, Converter={StaticResource PvBoolToVis}}">
                      <TextBlock Text="Mới" FontSize="10.5" FontWeight="SemiBold" Foreground="#86A8FF"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Owner}" Foreground="{StaticResource PvMuted}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="3" Text="{Binding Modified}" Foreground="{StaticResource PvMuted}" FontSize="12.5" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="{Binding Size}" Foreground="{StaticResource PvMuted}" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,60">
            <TextBlock x:Name="EmptyIcon" Style="{StaticResource PvIcon}" Text="&#xE74D;" FontSize="40" Foreground="{StaticResource PvFaint}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyHint" Foreground="{StaticResource PvMuted}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <!-- Thẻ thông báo gửi chéo giữa hai tài khoản -->
    <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,18" Width="610"
            Padding="22,18,16,18" CornerRadius="16" Background="#0D1320" BorderBrush="{StaticResource PvAccent}" BorderThickness="1"
            Visibility="Collapsed" Opacity="0" MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave">
      <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.55" Color="Black"/></Border.Effect>
      <Border.RenderTransform><TranslateTransform x:Name="ToastShift" Y="24"/></Border.RenderTransform>
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Width="24" Height="24">
            <TextBlock x:Name="ToastSpinner" Style="{StaticResource PvIcon}" Text="&#xE895;" FontSize="16" Foreground="{StaticResource PvAccent}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform><RotateTransform x:Name="SpinnerRotate"/></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="ToastDoneIcon" Style="{StaticResource PvIcon}" Text="&#xE930;" FontSize="20" Foreground="{StaticResource PvSuccess}" HorizontalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
          <TextBlock x:Name="ToastTitle" Grid.Column="1" FontSize="16.5" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <Border Grid.Column="2" CornerRadius="14" Padding="12,4" BorderThickness="1" BorderBrush="{StaticResource PvSuccess}" Background="{StaticResource PvSuccessSoft}" VerticalAlignment="Center" ToolTip="Dữ liệu được Google sao chép trên máy chủ, không đi qua mạng của máy này">
            <TextBlock Text="0 MB qua máy này" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PvSuccess}"/>
          </Border>
          <Button Grid.Column="3" Style="{StaticResource PvGhost}" Padding="8,7" Margin="6,0,0,0" Click="ToastClose_Click" ToolTip="Đóng">
            <TextBlock Style="{StaticResource PvIcon}" Text="&#xE711;" FontSize="10" Foreground="{StaticResource PvMuted}"/>
          </Button>
        </Grid>
        <Grid Margin="0,16,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="196"/>
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource PvAccentSoft}" BorderBrush="#2B4C93" BorderThickness="1" CornerRadius="11" Padding="14,9">
            <StackPanel>
              <TextBlock Text="TÀI KHOẢN NGUỒN" FontSize="10.5" FontWeight="Bold" Foreground="#86A8FF"/>
              <TextBlock x:Name="ToastSource" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
          <ProgressBar x:Name="ToastProgress" Grid.Column="1" Style="{StaticResource PvProgress}" Margin="18,0" VerticalAlignment="Center"/>
          <Border Grid.Column="2" Background="{StaticResource PvPurpleSoft}" BorderBrush="#4A3F92" BorderThickness="1" CornerRadius="11" Padding="14,9">
            <StackPanel>
              <TextBlock Text="ĐÍCH · SAO CHÉP TRÊN MÁY CHỦ" FontSize="10.5" FontWeight="Bold" Foreground="#B8ADFF" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="ToastTarget" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
        </Grid>
        <Grid Margin="0,14,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Chế độ: chia sẻ tạm · tự tải qua máy nếu bị chặn" FontSize="12.5" Foreground="{StaticResource PvMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="ToastStatus" Grid.Column="1" FontFamily="{StaticResource PvMonoFont}" FontSize="13" Foreground="{StaticResource PvAccent}" Margin="12,0,0,0"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Thanh trạng thái truyền file -->
    <Border Grid.Row="2" Background="{StaticResource PvChromeBg}" BorderBrush="{StaticResource PvLine}" BorderThickness="0,1,0,0">
      <Grid Margin="16,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource PvIcon}" Text="&#xE898;" FontSize="11" Foreground="{StaticResource PvAccent}"/>
          <TextBlock x:Name="UpSpeed" FontFamily="{StaticResource PvMonoFont}" FontSize="12" Foreground="{StaticResource PvAccent}" Margin="6,0,16,0" MinWidth="78"/>
          <TextBlock Style="{StaticResource PvIcon}" Text="&#xE896;" FontSize="11" Foreground="{StaticResource PvSuccess}"/>
          <TextBlock x:Name="DownSpeed" FontFamily="{StaticResource PvMonoFont}" FontSize="12" Foreground="{StaticResource PvSuccess}" Margin="6,0,12,0" MinWidth="78"/>
          <Rectangle Width="1" Height="14" Fill="{StaticResource PvLine}" Margin="0,0,14,0"/>
          <TextBlock x:Name="TaskText" FontSize="12" VerticalAlignment="Center" MinWidth="96"/>
          <ProgressBar x:Name="TaskBar" Style="{StaticResource PvProgress}" Width="120" Height="5" Foreground="{StaticResource PvAccent}" Margin="10,0,14,0"/>
          <TextBlock Style="{StaticResource PvIcon}" Text="&#xE916;" FontSize="11" Foreground="{StaticResource PvMuted}"/>
          <TextBlock x:Name="EtaText" FontFamily="{StaticResource PvMonoFont}" FontSize="12" Foreground="{StaticResource PvMuted}" Margin="6,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource PvWarningSoft}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" ToolTip="Không có tệp nào được gửi hay tải thật">
            <TextBlock Text="Dữ liệu minh họa" FontSize="11.5" Foreground="{StaticResource PvWarning}"/>
          </Border>
          <Button Style="{StaticResource PvGhost}" Padding="10,4" Margin="8,0,0,0" ToolTip="Bản dựng thử: chưa nối chức năng">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE769;" FontSize="11" Foreground="{StaticResource PvMuted}"/><TextBlock Text="Tạm dừng" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource PvMuted}"/></StackPanel>
          </Button>
          <Button Style="{StaticResource PvGhost}" Padding="10,4" ToolTip="Bản dựng thử: chưa nối chức năng">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource PvIcon}" Text="&#xE8FD;" FontSize="11" Foreground="{StaticResource PvMuted}"/><TextBlock Text="Hàng đợi" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource PvMuted}"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
