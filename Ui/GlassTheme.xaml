<!-- Bộ màu và kiểu "kính lỏng" cho bản dựng thử thứ hai: nền tối trước tiên, thẻ kính mờ có viền sáng phản chiếu. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DriveLink.Ui">
  <FontFamily x:Key="GlIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="GlMonoFont">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="GlDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>


  <!-- Viền sáng phản chiếu: sáng ở góc trên trái và góc dưới phải như mép kính. -->
  <BooleanToVisibilityConverter x:Key="GlBoolToVis"/>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
  </Style>
  <Style x:Key="GlIcon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource GlIconFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="GlLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource GlFaint}"/>
  </Style>
  <Style x:Key="GlTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource GlDisplayFont}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Thẻ kính dùng cho mọi widget trong lưới Bento. -->
  <Style TargetType="local:GlassCard">
    <Setter Property="Padding" Value="20,18"/>
    <Setter Property="Margin" Value="8"/>
    <Setter Property="Foreground" Value="{StaticResource GlInk}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:GlassCard">
          <Grid>
            <Border Margin="8,16,8,-8" CornerRadius="26" Background="{StaticResource P_66000000}" IsHitTestVisible="False">
              <Border.Effect><BlurEffect Radius="28" RenderingBias="Performance"/></Border.Effect>
            </Border>
            <Border x:Name="Glow" Margin="-2" CornerRadius="28" BorderThickness="3" BorderBrush="{StaticResource GlAccent}" Opacity="0" IsHitTestVisible="False">
              <Border.Effect><BlurEffect Radius="14" RenderingBias="Performance"/></Border.Effect>
            </Border>
            <Border CornerRadius="26" Background="{StaticResource GlTint}"/>
            <Border CornerRadius="26" Background="{StaticResource GlFill}"/>
            <Border CornerRadius="26" Background="{StaticResource GlSheen}" IsHitTestVisible="False"/>
            <Border x:Name="PART_Spot" CornerRadius="26" Opacity="0" IsHitTestVisible="False"/>
            <Border x:Name="Rim" CornerRadius="26" BorderThickness="1" BorderBrush="{StaticResource GlRim}" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Rim" Property="BorderBrush" Value="{StaticResource GlAccent}"/>
              <Setter TargetName="Glow" Property="Opacity" Value="0.9"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GlPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource GlPanelFill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlRim}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="26"/>
  </Style>
  <Style x:Key="GlChip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource P_12FFFFFF}"/>
    <Setter Property="BorderBrush" Value="{StaticResource P_1FFFFFFF}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="13"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="GlTile" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource P_0AFFFFFF}"/>
    <Setter Property="BorderBrush" Value="{StaticResource P_14FFFFFF}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource P_1CFFFFFF}"/>
        <Setter Property="BorderBrush" Value="{StaticResource P_38FFFFFF}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="GlRow" TargetType="Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource P_14FFFFFF}"/></Trigger>
    </Style.Triggers>
  </Style>

  <!-- Nút viên thuốc bằng kính: sáng lên khi rê chuột, lún nhẹ khi bấm rồi nảy lại. -->
  <Style x:Key="GlButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource GlInk}"/>
    <Setter Property="Background" Value="{StaticResource P_14FFFFFF}"/>
    <Setter Property="BorderBrush" Value="{StaticResource P_2EFFFFFF}"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="Press"/></Grid.RenderTransform>
            <Border CornerRadius="19" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
            <Border CornerRadius="19" Background="{StaticResource GlSheen}" IsHitTestVisible="False"/>
            <Border x:Name="Hover" CornerRadius="19" Background="{StaticResource GlHover}" Opacity="0" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.09" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.08"/>
                <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.08"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.7"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.7"/></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="GlPrimaryButton" TargetType="Button" BasedOn="{StaticResource GlButton}">
    <Setter Property="Background" Value="{StaticResource GlAccentFill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource P_66FFFFFF}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="{StaticResource PC_FF5B8CFF}" BlurRadius="22" ShadowDepth="0" Opacity="0.5"/></Setter.Value></Setter>
  </Style>

  <Style x:Key="GlRound" TargetType="Button">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Foreground" Value="{StaticResource GlMuted}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Chrome" CornerRadius="17" Background="Transparent"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource P_1AFFFFFF}"/><Setter Property="Foreground" Value="{StaticResource GlInk}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="GlRoundClose" TargetType="Button" BasedOn="{StaticResource GlRound}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Chrome" CornerRadius="17" Background="Transparent"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource P_FFE5484D}"/><Setter Property="Foreground" Value="White"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Công tắc chọn tài khoản: viên chỉ báo trượt được vẽ riêng trong cửa sổ. -->
  <Style x:Key="GlSegment" TargetType="RadioButton">
    <Setter Property="Width" Value="104"/>
    <Setter Property="Foreground" Value="{StaticResource GlMuted}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="GroupName" Value="GlAccounts"/>
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource GlInk}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Biểu tượng trên thanh dock: phóng nhẹ khi rê chuột. -->
  <Style x:Key="GlDock" TargetType="RadioButton">
    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="Foreground" Value="{StaticResource GlMuted}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="GroupName" Value="GlDock"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="Zoom"/></Grid.RenderTransform>
            <Border x:Name="Hover" CornerRadius="14" Background="{StaticResource GlHover}" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource GlInk}"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.15"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource GlDockSelected}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GlProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="5"/>
    <Setter Property="Background" Value="{StaticResource P_1AFFFFFF}"/>
    <Setter Property="Foreground" Value="{StaticResource GlAccent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"/>
            <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Chưa biết tổng dung lượng: thanh đầy và thở nhẹ thay vì đứng yên. -->
            <Trigger Property="IsIndeterminate" Value="True">
              <Trigger.EnterActions><BeginStoryboard x:Name="Breathe"><Storyboard>
                <DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><StopStoryboard BeginStoryboardName="Breathe"/></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GlSearch" TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource GlInk}"/>
    <Setter Property="CaretBrush" Value="{StaticResource GlInk}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource GlAccent}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Background="Transparent" Focusable="False"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dòng trong danh sách không gian. -->
  <Style x:Key="GlListItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource GlInk}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="12" Padding="10,8" Margin="0,1">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource P_14FFFFFF}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource P_335B8CFF}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thanh cuộn mảnh cho mọi danh sách trên nền kính. -->
  <Style x:Key="GlThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb"><Border Background="{StaticResource P_38FFFFFF}" CornerRadius="3"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb Style="{StaticResource GlThumb}" Margin="2"/></Track.Thumb></Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False"><Track.Thumb><Thumb Style="{StaticResource GlThumb}" Margin="2"/></Track.Thumb></Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
