<!-- Cửa sổ chính DriveLink: giao diện kính trên nền tối, bố cục Bento một màn. Danh sách tệp là widget chính; cột phải gồm các widget gửi tệp, truyền tải, không gian, dung lượng và gửi chéo. -->
<Window x:Class="DriveLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DriveLink"
        xmlns:ui="clr-namespace:DriveLink.Ui"
        Title="{x:Static local:AppBrand.WindowTitle}" Icon="{x:Static local:AppBrand.Icon}"
        Width="1366" Height="800" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterScreen"
        Background="#070A12" Foreground="#F2F5FB" FontSize="13.5" UseLayoutRounding="True"
        Loaded="Window_Loaded" Closing="Window_Closing" AllowDrop="True" PreviewDragOver="Upload_DragOver" PreviewDrop="Upload_Drop" DragLeave="Upload_DragLeave"
        PreviewMouseWheel="Zoom_MouseWheel" PreviewKeyDown="Zoom_KeyDown" SizeChanged="Window_SizeChanged">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DriveLink;component/Ui/GlassTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ui:FileIconConverter x:Key="FileIcon"/>
      <Style x:Key="GlCellText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GlMuted}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="WindowRoot" ClipToBounds="True">
    <!-- Nền cực quang trôi chậm phía sau lớp kính -->
    <Canvas IsHitTestVisible="False">
      <Ellipse Width="820" Height="820" Canvas.Left="-220" Canvas.Top="-300">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#7A3B6CFF" Offset="0"/><GradientStop Color="#003B6CFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="BlobA"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="900" Height="900" Canvas.Left="640" Canvas.Top="320">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#6A8B5CF6" Offset="0"/><GradientStop Color="#008B5CF6" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="BlobB"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="680" Height="680" Canvas.Left="980" Canvas.Top="-260">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#5014B8A6" Offset="0"/><GradientStop Color="#0014B8A6" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="BlobC"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="620" Height="620" Canvas.Left="120" Canvas.Top="560">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#38EC4899" Offset="0"/><GradientStop Color="#00EC4899" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="BlobD"/></Ellipse.RenderTransform>
      </Ellipse>
    </Canvas>
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush RadiusX="0.75" RadiusY="0.8"><GradientStop Color="#00050810" Offset="0.5"/><GradientStop Color="#B0050810" Offset="1"/></RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Grid x:Name="UiRoot">
      <Grid.LayoutTransform><ScaleTransform x:Name="UiScaleTransform"/></Grid.LayoutTransform>
      <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="52"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Thanh trên nổi dạng viên thuốc -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource GlPanel}" Padding="10,0,8,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
              <Image Source="{x:Static local:AppBrand.Icon}" Width="26" Height="26"/>
              <TextBlock x:Name="BrandText" Text="DriveLink" FontFamily="{StaticResource GlDisplayFont}" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="AccountHost" Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
              <Button x:Name="AccountMenuButton" Style="{StaticResource GlButton}" Height="36" Padding="5,0,14,0" Click="AccountsMenu_Click">
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="AccountAvatar" Width="26" Height="26" CornerRadius="13" Background="{StaticResource GlAccentFill}">
                    <TextBlock x:Name="AccountAvatarText" Text="+" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock x:Name="AccountMenuText" Text="Thêm tài khoản" Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Style="{StaticResource GlIcon}" Text="&#xE70D;" FontSize="9" Margin="9,1,0,0" Foreground="{StaticResource GlMuted}"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource GlRound}" Margin="6,0,0,0" Click="Connect_Click" ToolTip="Thêm tài khoản Google">
                <TextBlock Style="{StaticResource GlIcon}" Text="&#xE710;" FontSize="12"/>
              </Button>
            </StackPanel>
            <Border x:Name="SearchHost" Grid.Column="3" Width="290" Height="36" Background="#10FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="18" Margin="0,0,10,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource GlIcon}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource GlMuted}" Margin="14,0,10,0"/>
                <Grid Grid.Column="1" Margin="0,0,14,0">
                  <TextBox x:Name="SearchBox" Style="{StaticResource GlSearch}" TextChanged="Search_Changed" ToolTip="Tìm theo tên file hoặc email" AutomationProperties.Name="Tìm file hoặc email"/>
                  <TextBlock Text="Tìm tệp hoặc email…" Foreground="{StaticResource GlFaint}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Grid>
            </Border>
            <Border x:Name="UpdateNotice" Grid.Column="4" Background="#1F5B8CFF" BorderBrush="#665B8CFF" BorderThickness="1" CornerRadius="17" Padding="12,0,4,0" Height="34" Margin="0,0,10,0" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource GlIcon}" Text="&#xE896;" FontSize="12" Foreground="#9DB8FF"/>
                <TextBlock x:Name="UpdateNoticeText" FontSize="12" Margin="8,0,8,0" VerticalAlignment="Center" Foreground="#CFE0FF"/>
                <Button Style="{StaticResource GlPrimaryButton}" Height="26" Padding="10,0" Click="Updates_Click" Effect="{x:Null}">
                  <TextBlock Text="Cập nhật" FontSize="12" FontWeight="SemiBold"/>
                </Button>
              </StackPanel>
            </Border>
            <Border Grid.Column="5" Background="#10FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="18" Height="36" Padding="2,0" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GlRound}" Width="30" Height="30" Click="ZoomOut_Click" ToolTip="Thu nhỏ (Ctrl + −)"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE738;" FontSize="10"/></Button>
                <Button x:Name="ZoomLabel" Style="{StaticResource GlButton}" Height="30" Padding="6,0" MinWidth="50" Background="Transparent" BorderBrush="Transparent" FontSize="12" Click="ZoomReset_Click" ToolTip="Tự điều chỉnh theo màn hình (Ctrl + 0)" Content="100%"/>
                <Button Style="{StaticResource GlRound}" Width="30" Height="30" Click="ZoomIn_Click" ToolTip="Phóng to (Ctrl + +)"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE710;" FontSize="10"/></Button>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="6" Orientation="Horizontal">
              <Button Style="{StaticResource GlRound}" Click="Minimize_Click" ToolTip="Thu nhỏ"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE921;" FontSize="10"/></Button>
              <Button Style="{StaticResource GlRound}" Click="Maximize_Click" ToolTip="Phóng to"><TextBlock x:Name="MaxGlyph" Style="{StaticResource GlIcon}" Text="&#xE922;" FontSize="10"/></Button>
              <Button Style="{StaticResource GlRoundClose}" Click="CloseWindow_Click" ToolTip="Đóng"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE8BB;" FontSize="10"/></Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Dock: bộ lọc tệp, cài đặt và cập nhật -->
        <Border Grid.Row="1" Style="{StaticResource GlPanel}" CornerRadius="32" Margin="0,16,0,0" Padding="0,8" VerticalAlignment="Top">
          <StackPanel HorizontalAlignment="Center">
            <Grid>
              <Border Width="44" Height="44" Margin="0,4,0,0" VerticalAlignment="Top" CornerRadius="14" Background="#335B8CFF" BorderBrush="#665B8CFF" BorderThickness="1">
                <Border.RenderTransform><TranslateTransform x:Name="DockShift"/></Border.RenderTransform>
              </Border>
              <StackPanel>
                <RadioButton x:Name="RecentButton" Style="{StaticResource GlDock}" IsChecked="True" Click="Recent_Click" ToolTip="File gần đây"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE81C;" FontSize="17"/></RadioButton>
                <RadioButton x:Name="SentButton" Style="{StaticResource GlDock}" Click="Sent_Click" ToolTip="Tôi đã gửi"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE898;" FontSize="17"/></RadioButton>
                <RadioButton x:Name="ReceivedButton" Style="{StaticResource GlDock}" Click="Received_Click" ToolTip="Từ người khác"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE896;" FontSize="17"/></RadioButton>
              </StackPanel>
            </Grid>
            <Rectangle Height="1" Width="28" Fill="{StaticResource GlLine}" Margin="0,8"/>
            <Button Style="{StaticResource GlRound}" Width="44" Height="44" Click="Settings_Click" ToolTip="Cài đặt"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE713;" FontSize="17"/></Button>
            <Button Style="{StaticResource GlRound}" Width="44" Height="44" Margin="0,4,0,0" Click="Updates_Click" ToolTip="Kiểm tra cập nhật">
              <Grid>
                <TextBlock Style="{StaticResource GlIcon}" Text="&#xE895;" FontSize="16"/>
                <Ellipse x:Name="UpdateDot" Width="7" Height="7" Fill="{StaticResource GlAccent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-4,0" Visibility="Collapsed"/>
              </Grid>
            </Button>
            <Button x:Name="DemoButton" Content="Xem thử giao diện" Visibility="Collapsed" Click="Demo_Click"/>
          </StackPanel>
        </Border>

        <!-- Lưới Bento -->
        <Grid x:Name="Bento" Grid.Row="1" Grid.Column="1" Margin="8,6,-8,-8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Widget chính: tệp trong không gian -->
          <ui:GlassCard x:Name="FilesCard" HoverLift="0" Padding="22,18,22,16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="SpaceDot" Width="10" Height="10" Fill="{StaticResource GlAccent}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SpaceTitle" Text="Chọn không gian để gửi và nhận file" FontFamily="{StaticResource GlDisplayFont}" FontSize="21" FontWeight="SemiBold" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock x:Name="SpaceSubtitle" Text="Thả file hoặc thư mục vào bất kỳ đâu trong ứng dụng" FontSize="12.5" Foreground="{StaticResource GlMuted}" Margin="20,3,10,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="MembersButton" Style="{StaticResource GlButton}" Height="34" Padding="12,0" Click="Members_Click" ToolTip="Thành viên không gian">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE716;" FontSize="13"/><TextBlock x:Name="MembersText" Text="Thành viên" Margin="8,0,0,0"/></StackPanel>
                  </Button>
                  <Button Style="{StaticResource GlButton}" Height="34" Padding="12,0" Margin="8,0,0,0" Click="CopySpace_Click" ToolTip="Sao chép liên kết thư mục không gian">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE71B;" FontSize="13"/><TextBlock x:Name="CopyLinkText" Text="Sao chép link" Margin="8,0,0,0"/></StackPanel>
                  </Button>
                  <Button Style="{StaticResource GlRound}" Margin="6,0,0,0" Click="Refresh_Click" ToolTip="Làm mới"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE72C;" FontSize="13"/></Button>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1" Margin="0,14,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="ListTitle" Text="File gần đây" FontFamily="{StaticResource GlDisplayFont}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Border Style="{StaticResource GlChip}" Margin="10,0,0,0" Padding="9,1"><TextBlock x:Name="CountLabel" FontSize="11.5" Foreground="{StaticResource GlMuted}"/></Border>
                </StackPanel>
                <TextBlock x:Name="StatusLabel" Grid.Column="1" Text="Chưa kết nối Google" FontSize="12" Foreground="{StaticResource GlMuted}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
              </Grid>
              <Border Grid.Row="2" Background="#0BFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="16">
                <Grid>
                  <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False"
                            HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="40" ColumnHeaderHeight="34" Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                            Foreground="{StaticResource GlInk}" SelectionMode="Single" SelectionChanged="File_Changed" PreviewMouseLeftButtonUp="FileRow_Click"
                            EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" Margin="6,4,4,4">
                    <DataGrid.Resources>
                      <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="{StaticResource GlFaint}"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                              <Border Background="Transparent" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                      <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource GlInk}"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                              <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                      <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0FFFFFFF"/></Trigger>
                          <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2E5B8CFF"/></Trigger>
                        </Style.Triggers>
                      </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="TÊN FILE" Width="*" MinWidth="210">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                              <TextBlock Style="{StaticResource GlIcon}" Text="{Binding Converter={StaticResource FileIcon}}" Foreground="{Binding Converter={StaticResource FileIcon}, ConverterParameter=brush}" FontSize="16" HorizontalAlignment="Left"/>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NameLabel}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{StaticResource GlFaint}" Margin="0,1,0,0"/>
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="CHỦ SỞ HỮU" Binding="{Binding OwnerLabel}" Width="160" ElementStyle="{StaticResource GlCellText}"/>
                      <DataGridTextColumn Header="DUNG LƯỢNG" Binding="{Binding SizeLabel}" Width="108" ElementStyle="{StaticResource GlCellText}"/>
                      <DataGridTextColumn Header="ĐƯỢC TẠO" Binding="{Binding TimeLabel}" Width="128" ElementStyle="{StaticResource GlCellText}"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="20">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#1F5B8CFF" BorderBrush="#4D5B8CFF" BorderThickness="1" HorizontalAlignment="Center">
                      <TextBlock Style="{StaticResource GlIcon}" Text="&#xE898;" FontSize="26" Foreground="#9DB8FF" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Text="Sẵn sàng cho file đầu tiên" FontFamily="{StaticResource GlDisplayFont}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock x:Name="EmptyDescription" Text="Thêm tài khoản Google, tạo không gian và mời tài khoản trên máy còn lại để bắt đầu." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource GlMuted}" Margin="0,10,0,0" LineHeight="21"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectionLabel" Text="Chọn file để tải về hoặc mở trên Drive." FontSize="12.5" Foreground="{StaticResource GlMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button x:Name="OpenDriveButton" Grid.Column="1" Style="{StaticResource GlButton}" Margin="12,0,8,0" Click="OpenFile_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE8A7;" FontSize="12"/><TextBlock Text="Mở trên Drive" Margin="8,0,0,0"/></StackPanel>
                </Button>
                <Button x:Name="DownloadFileButton" Grid.Column="2" Style="{StaticResource GlPrimaryButton}" Click="Download_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE896;" FontSize="13"/><TextBlock Text="Tải về" Margin="8,0,0,0" FontWeight="SemiBold"/></StackPanel>
                </Button>
              </Grid>
              <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ProgressBar x:Name="TransferProgress" Style="{StaticResource GlProgress}" Minimum="0" Maximum="100" Visibility="Collapsed" VerticalAlignment="Center"/>
                <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource GlButton}" Height="28" Padding="12,0" Margin="10,0,0,0" Visibility="Collapsed" Click="Cancel_Click" Content="Hủy"/>
              </Grid>
            </Grid>
          </ui:GlassCard>

          <!-- Cột widget: cuộn được khi cửa sổ thấp -->
          <ScrollViewer x:Name="SideScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid x:Name="SideGrid" Width="600" MinHeight="600">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColA" Width="*"/>
                <ColumnDefinition x:Name="SideColB" Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- Gửi tệp -->
              <ui:GlassCard x:Name="SendCard" Padding="18,16">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid>
                    <TextBlock Text="Gửi tệp" Style="{StaticResource GlTitle}"/>
                    <TextBlock x:Name="SendTarget" FontSize="11.5" Foreground="{StaticResource GlFaint}" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                  <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid x:Name="OrbHost" Width="76" Height="76">
                      <Ellipse x:Name="Pulse1" Width="56" Height="56" Stroke="#995B8CFF" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform x:Name="Pulse1Scale"/></Ellipse.RenderTransform></Ellipse>
                      <Border x:Name="Orb" Width="56" Height="56" CornerRadius="28" Background="{StaticResource GlAccentFill}" BorderBrush="#8CFFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="OrbScale"/></Border.RenderTransform>
                        <Border.Effect><DropShadowEffect Color="#5B8CFF" BlurRadius="26" ShadowDepth="0" Opacity="0.65"/></Border.Effect>
                        <Grid>
                          <Border CornerRadius="28">
                            <Border.Background><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#59FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.55"/></LinearGradientBrush></Border.Background>
                          </Border>
                          <TextBlock Style="{StaticResource GlIcon}" Text="&#xE898;" FontSize="22" Foreground="White" HorizontalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="DropTitle" Text="Thả tệp vào bất kỳ đâu" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                      <TextBlock x:Name="DropHint" Text="Thư mục được nén trước khi gửi" FontSize="11.5" Foreground="{StaticResource GlMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                  </Grid>
                  <UniformGrid Grid.Row="2" Columns="2">
                    <Button x:Name="FileUploadButton" Style="{StaticResource GlPrimaryButton}" Margin="0,0,4,0" Padding="8,0" Click="Upload_Click" ToolTip="Chọn file để gửi">
                      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE8E5;" FontSize="13"/><TextBlock Text="Chọn tệp" Margin="7,0,0,0" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button x:Name="FolderUploadButton" Style="{StaticResource GlButton}" Margin="4,0,0,0" Padding="8,0" Click="UploadFolder_Click" ToolTip="Chọn thư mục để nén rồi gửi">
                      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE838;" FontSize="13"/><TextBlock Text="Thư mục" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                  </UniformGrid>
                </Grid>
              </ui:GlassCard>

              <!-- Truyền tải -->
              <ui:GlassCard x:Name="TransferCard" Grid.Column="1" Grid.RowSpan="2" Padding="18,16">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid>
                    <TextBlock Text="Truyền tải" Style="{StaticResource GlTitle}"/>
                    <Border x:Name="LiveChip" HorizontalAlignment="Right" Background="#14FFFFFF" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{StaticResource GlFaint}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LiveText" Text="Rảnh" FontSize="11.5" Foreground="{StaticResource GlMuted}" Margin="6,0,0,0"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                  <UniformGrid Grid.Row="1" Columns="2" Margin="0,12,0,0">
                    <StackPanel>
                      <TextBlock Text="TẢI LÊN" Style="{StaticResource GlLabel}"/>
                      <TextBlock x:Name="UploadSpeed" Text="0 B/s" FontFamily="{StaticResource GlMonoFont}" FontSize="17" Foreground="#8FB0FF" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="TẢI VỀ" Style="{StaticResource GlLabel}"/>
                      <TextBlock x:Name="DownloadSpeed" Text="0 B/s" FontFamily="{StaticResource GlMonoFont}" FontSize="17" Foreground="{StaticResource GlGreen}" Margin="0,3,0,0"/>
                    </StackPanel>
                  </UniformGrid>
                  <Canvas x:Name="Spark" Grid.Row="2" MinHeight="40" Margin="0,10,0,6" ClipToBounds="True" SizeChanged="Spark_SizeChanged">
                    <Polygon x:Name="SparkUpFill">
                      <Polygon.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#665B8CFF" Offset="0"/><GradientStop Color="#005B8CFF" Offset="1"/></LinearGradientBrush></Polygon.Fill>
                    </Polygon>
                    <Polyline x:Name="SparkDown" Stroke="{StaticResource GlGreen}" StrokeThickness="1.5" Opacity="0.8" StrokeLineJoin="Round"/>
                    <Polyline x:Name="SparkUp" Stroke="#8FB0FF" StrokeThickness="2" StrokeLineJoin="Round"/>
                  </Canvas>
                  <StackPanel Grid.Row="3" Margin="0,6,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock x:Name="UploadLabel" Text="Gửi: sẵn sàng" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Button x:Name="CancelUploads" Grid.Column="1" Style="{StaticResource GlButton}" Height="24" Padding="10,0" FontSize="11.5" Margin="8,0,0,0" Content="Hủy gửi" IsEnabled="False" Click="CancelUploads_Click"/>
                    </Grid>
                    <ProgressBar x:Name="UploadProgress" Style="{StaticResource GlProgress}" Foreground="#8FB0FF" Minimum="0" Maximum="100" Margin="0,6,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Row="4" Margin="0,12,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock x:Name="DownloadLabel" Text="Nhận: sẵn sàng" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Button x:Name="CancelDownloads" Grid.Column="1" Style="{StaticResource GlButton}" Height="24" Padding="10,0" FontSize="11.5" Margin="8,0,0,0" Content="Hủy nhận" IsEnabled="False" Click="CancelDownloads_Click"/>
                    </Grid>
                    <ProgressBar x:Name="DownloadProgress" Style="{StaticResource GlProgress}" Foreground="{StaticResource GlGreen}" Minimum="0" Maximum="100" Margin="0,6,0,0"/>
                  </StackPanel>
                </Grid>
              </ui:GlassCard>

              <!-- Không gian chung -->
              <ui:GlassCard x:Name="SpacesCard" Grid.Row="1" Padding="14,14">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Grid Margin="6,0,0,6">
                    <TextBlock Text="Không gian" Style="{StaticResource GlTitle}"/>
                    <Button Style="{StaticResource GlRound}" Width="28" Height="28" HorizontalAlignment="Right" Click="CreateSpace_Click" ToolTip="Tạo không gian"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE710;" FontSize="11"/></Button>
                  </Grid>
                  <ListBox x:Name="SpacesList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GlInk}" SelectionChanged="Space_Changed"
                           ItemContainerStyle="{StaticResource GlListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Ellipse Width="9" Height="9" Fill="{Binding Color}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding PinLabel}" Foreground="{StaticResource GlAmber}" VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </ui:GlassCard>

              <!-- Gửi chéo tài khoản -->
              <ui:GlassCard x:Name="CrossCard" Grid.Row="2" Padding="18,16">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid>
                    <TextBlock Text="Gửi chéo" Style="{StaticResource GlTitle}"/>
                    <Border HorizontalAlignment="Right" Background="#1A4ADE80" BorderBrush="#554ADE80" BorderThickness="1" CornerRadius="11" Padding="8,1" VerticalAlignment="Center" ToolTip="Google sao chép trên máy chủ nên không tốn băng thông máy này">
                      <TextBlock Text="0 MB qua máy" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GlGreen}"/>
                    </Border>
                  </Grid>
                  <Border Grid.Row="1" Margin="0,10,0,0" Background="#1F5B8CFF" BorderBrush="#4D5B8CFF" BorderThickness="1" CornerRadius="12" Padding="10,6">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource GlIcon}" Text="&#xE8A5;" FontSize="14" Foreground="#9DB8FF"/>
                      <StackPanel Grid.Column="1" Margin="9,0,0,0">
                        <TextBlock x:Name="CrossSource" Text="Chọn một tệp trong danh sách" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="CrossSourceMeta" FontSize="11" Foreground="{StaticResource GlMuted}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Grid Grid.Row="2" Height="16" Margin="12,6,12,0">
                    <Rectangle Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Center" Opacity="0.45">
                      <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#5B8CFF" Offset="0"/><GradientStop Color="#A78BFA" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                    </Rectangle>
                    <Canvas x:Name="FlowCanvas" ClipToBounds="True" SizeChanged="Flow_SizeChanged"/>
                  </Grid>
                  <TextBlock x:Name="CrossStatus" Grid.Row="3" FontFamily="{StaticResource GlMonoFont}" FontSize="11" Foreground="{StaticResource GlMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,4"/>
                  <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="CrossTargetButton" Style="{StaticResource GlButton}" Height="34" Padding="10,0" Click="CrossTarget_Click" HorizontalContentAlignment="Left">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GlIcon}" Text="&#xE77B;" FontSize="13" Foreground="#C4B5FD"/>
                        <TextBlock x:Name="CrossTargetText" Text="Chọn tài khoản đích" Margin="8,0,0,0" FontSize="12.5" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="CrossButton" Grid.Column="1" Style="{StaticResource GlPrimaryButton}" Height="34" Padding="14,0" Margin="8,0,0,0" Click="Cross_Click" IsEnabled="False">
                      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlIcon}" Text="&#xE8AB;" FontSize="12"/><TextBlock Text="Gửi" Margin="7,0,0,0" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                  </Grid>
                </Grid>
              </ui:GlassCard>

              <!-- Dung lượng -->
              <ui:GlassCard x:Name="StorageCard" Grid.Row="2" Grid.Column="1" Padding="18,16">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Grid>
                    <TextBlock Text="Dung lượng" Style="{StaticResource GlTitle}"/>
                    <TextBlock x:Name="QuotaAccount" FontSize="11" Foreground="{StaticResource GlFaint}" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                  <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="78" Height="78">
                      <Ellipse Stroke="#1FFFFFFF" StrokeThickness="7"/>
                      <Ellipse x:Name="QuotaRing" Stroke="{StaticResource GlAccent}" StrokeThickness="7" StrokeDashCap="Round" Opacity="0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse>
                      <TextBlock x:Name="QuotaPercent" Text="—" FontFamily="{StaticResource GlDisplayFont}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="QuotaText" Text="Chưa có dữ liệu" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="QuotaDetail" FontSize="11.5" Foreground="{StaticResource GlMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                  </Grid>
                </Grid>
              </ui:GlassCard>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- Lớp thả tệp phủ toàn cửa sổ -->
      <Border x:Name="DropOverlay" Panel.ZIndex="20" Background="#A60A0F1E" BorderBrush="{StaticResource GlAccent}" BorderThickness="2" CornerRadius="28" Margin="12" Visibility="Collapsed" IsHitTestVisible="False">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border Width="120" Height="120" CornerRadius="60" Background="{StaticResource GlAccentFill}" BorderBrush="#8CFFFFFF" BorderThickness="1" HorizontalAlignment="Center">
            <Border.Effect><DropShadowEffect Color="#5B8CFF" BlurRadius="48" ShadowDepth="0" Opacity="0.75"/></Border.Effect>
            <TextBlock Style="{StaticResource GlIcon}" Text="&#xE898;" FontSize="44" Foreground="White" HorizontalAlignment="Center"/>
          </Border>
          <TextBlock Text="Thả để gửi vào không gian đang chọn" FontFamily="{StaticResource GlDisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,22,0,0" HorizontalAlignment="Center"/>
          <TextBlock x:Name="DropOverlayHint" Text="Bạn có thể tiếp tục gửi trong khi đang nhận file." FontSize="14" Foreground="{StaticResource GlMuted}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>

      <!-- "Đảo" thông báo: viên thuốc nổi ở giữa phía trên, co giãn theo trạng thái -->
      <Border x:Name="Island" Panel.ZIndex="30" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,74,0,0" Width="160" Height="44" Opacity="0" Visibility="Collapsed"
              CornerRadius="24" Background="#F00C111D" BorderBrush="{StaticResource GlRim}" BorderThickness="1" ClipToBounds="True" IsHitTestVisible="False">
        <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.6" Color="Black"/></Border.Effect>
        <Grid Margin="16,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Width="22" Height="22" VerticalAlignment="Center">
            <TextBlock x:Name="IslandSpinner" Style="{StaticResource GlIcon}" Text="&#xE895;" FontSize="14" Foreground="{StaticResource GlAccent}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform><RotateTransform x:Name="IslandSpin"/></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="IslandCheck" Style="{StaticResource GlIcon}" Text="&#xE930;" FontSize="18" Foreground="{StaticResource GlGreen}" HorizontalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="IslandWarn" Style="{StaticResource GlIcon}" Text="&#xE7BA;" FontSize="16" Foreground="{StaticResource GlAmber}" HorizontalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="IslandText" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="IslandSub" FontSize="11.5" Foreground="{StaticResource GlMuted}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
      </Border>

      <ComboBox x:Name="AccountsBox" Visibility="Collapsed" SelectionChanged="Account_Changed"/>
    </Grid>
  </Grid>
</Window>
