<Window x:Class="DriveLink.LoginStatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DriveLink"
 Title="Đăng nhập Google — Quang Huy" Icon="{x:Static local:AppBrand.Icon}" Width="430" Height="350" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F5F7FB" Closing="Window_Closing">
 <Border Margin="16" Background="White" CornerRadius="16" BorderBrush="#E1E8F3" BorderThickness="1" Padding="24">
  <StackPanel>
   <StackPanel Orientation="Horizontal"><Image Source="{x:Static local:AppBrand.Icon}" Width="54" Height="54" Stretch="Uniform" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="DriveLink" FontSize="22" FontWeight="Bold"/><TextBlock Text="{x:Static local:AppBrand.Credit}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></StackPanel>
   <TextBlock x:Name="StateTitle" Text="Đang chờ đăng nhập Google" FontSize="19" FontWeight="SemiBold" Margin="0,22,0,10" TextWrapping="Wrap"/>
   <TextBlock x:Name="StateDetail" Text="Hoàn tất đăng nhập và cấp quyền trong trình duyệt. Cửa sổ này sẽ cập nhật khi có kết quả." FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" MaxHeight="64"/>
   <ProgressBar x:Name="WaitingProgress" IsIndeterminate="True" Height="4" Margin="0,16,0,14" Foreground="{StaticResource Accent}"/>
   <Grid><TextBlock x:Name="Countdown" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button x:Name="CancelLogin" Content="Hủy đăng nhập" Click="Cancel_Click" HorizontalAlignment="Right" Padding="12,6" FontSize="12"/></Grid>
  </StackPanel>
 </Border>
</Window>
