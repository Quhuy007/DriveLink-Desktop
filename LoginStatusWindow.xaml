<Window x:Class="DriveLink.LoginStatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DriveLink"
 Title="Đăng nhập Google — Quang Huy" Icon="{x:Static local:AppBrand.Icon}" Width="440" Height="370" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#0B1020" Foreground="#F2F5FB" Closing="Window_Closing">
 <!-- Thẻ kính chờ đăng nhập: nền và thanh tiêu đề tối được áp khi cửa sổ mở (Ui/Theme.cs). -->
 <Grid>
  <Ellipse Width="260" Height="260" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-90,-110,0,0" IsHitTestVisible="False">
   <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#665B8CFF" Offset="0"/><GradientStop Color="#005B8CFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
  </Ellipse>
  <Ellipse Width="240" Height="240" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-90,-110" IsHitTestVisible="False">
   <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#558B5CF6" Offset="0"/><GradientStop Color="#008B5CF6" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
  </Ellipse>
  <Border Margin="16" CornerRadius="20" BorderThickness="1" Padding="24">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#22FFFFFF" Offset="0"/><GradientStop Color="#0AFFFFFF" Offset="0.6"/><GradientStop Color="#12FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background>
   <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#80FFFFFF" Offset="0"/><GradientStop Color="#1AFFFFFF" Offset="0.4"/><GradientStop Color="#45FFFFFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
   <StackPanel>
    <StackPanel Orientation="Horizontal"><Image Source="{x:Static local:AppBrand.Icon}" Width="54" Height="54" Stretch="Uniform" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="DriveLink" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{x:Static local:AppBrand.Credit}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></StackPanel>
    <TextBlock x:Name="StateTitle" Text="Đang chờ đăng nhập Google" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="19" FontWeight="SemiBold" Margin="0,22,0,10" TextWrapping="Wrap"/>
    <TextBlock x:Name="StateDetail" Text="Hoàn tất đăng nhập và cấp quyền trong trình duyệt. Cửa sổ này sẽ cập nhật khi có kết quả." FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" MaxHeight="64"/>
    <ProgressBar x:Name="WaitingProgress" IsIndeterminate="True" Height="5" Margin="0,16,0,14" Foreground="{StaticResource AccentFill}"/>
    <Grid><TextBlock x:Name="Countdown" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button x:Name="CancelLogin" Content="Hủy đăng nhập" Click="Cancel_Click" HorizontalAlignment="Right" Padding="14,7" FontSize="12"/></Grid>
   </StackPanel>
  </Border>
 </Grid>
</Window>
